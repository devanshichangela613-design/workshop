prices = list(map(int, input("Enter sorted prices: ").split()))
target = int(input("Enter target price: "))

low = 0
high = len(prices) - 1
ans = -1

while low <= high:
    mid = (low + high) // 2

    if prices[mid] >= target:
        ans = mid
        high = mid - 1
    else:
        low = mid + 1

if ans != -1:
    print("First product price >= target:", prices[ans])
else:
    print("No product found.")

output:

Enter sorted prices: 25000 35000 45000 50000 60000 75000
Enter target price: 50000
First product price >= target: 50000
