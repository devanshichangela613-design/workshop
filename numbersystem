num = int(input("Enter a decimal number: "))

print("1. Binary")
print("2. Octal")
print("3. Hexadecimal")

choice = int(input("Enter your choice: "))

match choice:
    case 1:
        print("Binary =", format(num, "b"))
    case 2:
        print("Octal =", format(num, "o"))
    case 3:
        print("Hexadecimal =", format(num, "X"))
    case _:
        print("Invalid Choice")
