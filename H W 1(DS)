n = int(input("Enter number of spam IDs: "))
spam = []

for i in range(n):
    spam.append(input("Enter Spam ID: "))

search = input("Enter sender ID to search: ")

found = False
for i in spam:
    if i == search:
        found = True
        break

if found:
    print("Spam sender found.")
else:
    print("Not a spam sender.")

